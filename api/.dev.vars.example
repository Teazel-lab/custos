# Copy to api/.dev.vars. Wrangler loads it for `wrangler dev`. Never commit .dev.vars.
# Production values go in with `wrangler secret put`. Do not paste them into chat.
#
# One URL is one network. Chain 56 never reads the chain 97 URL, and the reverse.

# Plain JSON-RPC for chain 56 (eth_simulateV1, eth_call, eth_estimateGas, eth_getCode, registry).
# Alchemy BSC mainnet: https://bnb-mainnet.g.alchemy.com/v2/<key>
# Empty falls back to https://bsc.publicnode.com.
RPC_URL_56=

# Plain JSON-RPC for chain 97.
# Alchemy BSC testnet: https://bnb-testnet.g.alchemy.com/v2/<key>
# Empty falls back to https://bsc-testnet.publicnode.com.
RPC_URL_97=

# debug_traceCall (callTracer, withLog: true) for chain 56.
# This is the primary mainnet path. Alchemy Pay As You Go on bnb-mainnet answers it.
# Empty skips the trace tier and uses eth_simulateV1 on RPC_URL_56, then eth_call.
TRACE_RPC_URL_56=

# debug_traceCall for chain 97. Empty skips the trace tier on testnet.
TRACE_RPC_URL_97=

# Optional. Rewrites the explanation only. The verdict is computed before this call.
LLM_API_KEY=

# Optional GoPlus Security API credentials. Both must be set, or neither.
# When both are set, the Worker fetches an access token and sends it as Authorization.
# The token is cached in KV. The key, secret, and token are never logged.
# Leave both empty to call GoPlus without authentication.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Allow http://localhost, http://127.0.0.1, and http://[::1] while running wrangler dev.
# Do not set this in production.
ALLOW_DEV_ORIGINS=1
