# Copy to api/.dev.vars. Wrangler loads it for `wrangler dev`. Never commit .dev.vars.
# Production values go in with `wrangler secret put`. Do not paste them into chat.

# Plain JSON-RPC for eth_simulateV1, eth_call, eth_estimateGas, eth_getCode, and registry reads.
# Alchemy BSC mainnet: https://bnb-mainnet.g.alchemy.com/v2/<key>
# Alchemy BSC testnet: https://bnb-testnet.g.alchemy.com/v2/<key>
# Point this at the network you are checking. If empty, a public RPC is used.
RPC_URL=

# Optional debug_traceCall endpoint. Leave empty on providers that reject traces
# (Alchemy's free tier does). Swap the URL to change provider later
# (NodeReal MegaNode, QuickNode, or any other trace-capable endpoint).
TRACE_RPC_URL=

# Optional. Rewrites the explanation only. The verdict is computed before this call.
LLM_API_KEY=
