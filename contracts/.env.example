# Copy to contracts/.env. Forge loads it from this directory. Never commit .env.
# Broadcast with `forge script --account <keystore>`. Do not put a key in this file.

# Chain 56 and chain 97 HTTP endpoints. Any RPC for those chain IDs is fine.
BSC_RPC_URL=https://bsc.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com

# Etherscan API V2 key. One key verifies both chains.
# https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=
